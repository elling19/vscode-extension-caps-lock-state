{
    "name": "caps-lock-state",
    "displayName": "Caps Lock State",
    "description": "This is a Visual Studio Code plugin that provides panels to display the Caps Lock key's status.",
    "icon": "./caps.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/elling19/vscode-extension-caps-lock-state.git"
    },
    "publisher": "Elling",
    "version": "0.0.8",
    "engines": {
        "vscode": "^1.84.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "extensionKind": ["ui"],
    "capabilities": {
        "virtualWorkspaces": false
    },
    "contributes": {
        "commands": [
            {
                "command": "caps-lock-config",
                "title": "caps lock config"
            },
            {
                "command": "caps-lock-state.toggle",
                "title": "Caps Lock State: Toggle Feature"
            }
        ],
        "configuration": {
            "title": "Caps Lock State",
            "properties": {
                "caps-lock-state.delay_time": {
                    "type": "integer",
                    "default": 20,
                    "markdownDescription": "Polling interval for detecting Caps Lock state changes (ms). Lower values = faster response, higher CPU usage.",
                    "order": 0
                },
                "caps-lock-state.editorCursor.foreground": {
                    "type": "string",
                    "default": "#00ff00",
                    "markdownDescription": "Cursor color when Caps Lock is ON. Examples: `#00ff00`, `red`, `rgba(0, 255, 0, 1)`",
                    "order": 1
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.3",
        "@types/node": "18.x",
        "@types/vscode": "^1.84.0",
        "@typescript-eslint/eslint-plugin": "^6.9.0",
        "@typescript-eslint/parser": "^6.9.0",
        "@vscode/test-electron": "^2.3.6",
        "eslint": "^8.52.0",
        "glob": "^10.3.10",
        "mocha": "^10.2.0",
        "ts-loader": "^9.5.0",
        "typescript": "^5.2.2",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "child_process": "^1.0.2",
        "ps-list": "^8.1.1"
    }
}
